const PLATFORM_INFO={
 facebook:"Connect with official Meta authorization",
 instagram:"Connect with official Instagram authorization",
 telegram:"Connect using your configured Telegram bot",
 x:"Connect with official X authorization",
 youtube:"Connect with official Google/YouTube authorization",
 tiktok:"Connect with official TikTok authorization",
 pinterest:"Connect with official Pinterest authorization",
 reddit:"Connect with official Reddit authorization"
}

function connectors(){
 const cards=Object.entries(PLATFORM_INFO).map(([p,info])=>`
 <div class="connector">
   <h3>${p[0].toUpperCase()+p.slice(1)}</h3>
   <p>${info}</p>
   <button class="ghost oauthInfo" data-platform="${p}">Connect</button>
 </div>`).join("");

 return `
 <div class="title-row">
   <h2>Social Accounts</h2>
   <button id="showWebsite" class="primary">Configure Website</button>
 </div>

 <div class="note" style="margin-bottom:16px">
   <b>Manual access-token fields are removed.</b>
   <div class="muted" style="margin-top:5px">
     Accounts are only marked connected after a real backend connector/OAuth flow succeeds.
   </div>
 </div>

 <div class="connector-grid">${cards}</div>

 <div id="websiteBox" class="panel form-panel hidden" style="margin-top:16px">
   <h3>Custom Website</h3>
   <p class="muted">Configure a webhook endpoint for website publishing.</p>
   <form id="websiteForm">
     <input name="account_name" required placeholder="Website name">
     <input name="webhook_url" type="url" required placeholder="https://example.com/api/webhook">
     <div class="toolbar">
       <button class="primary">Save Website Connector</button>
       <button type="button" class="ghost cancel">Cancel</button>
     </div>
   </form>
 </div>

 <div class="panel" style="margin-top:16px">
   <h3>Connected Accounts</h3>
   <table>
    <thead><tr><th>ID</th><th>Platform</th><th>Account</th><th>Status</th><th>Expires</th></tr></thead>
    <tbody>
    ${
      S.connectors.map(c=>`
       <tr>
        <td>#${c.id}</td>
        <td>${esc(c.platform)}</td>
        <td>${esc(c.account_name)}</td>
        <td><span class="status">${esc(c.status)}</span></td>
        <td>${esc(c.token_expires_at||"-")}</td>
       </tr>`).join("")
      || `<tr><td colspan="5" class="empty">No connected accounts</td></tr>`
    }
    </tbody>
   </table>
 </div>`;
}

function scheduler(){
 return `
 <div class="title-row">
  <h2>Scheduler</h2>
  <button id="showJob" class="primary">Schedule Post</button>
 </div>

 <div id="jobBox" class="panel form-panel hidden">
  <form id="jobForm">
   <select name="post_id" required>
    ${
      S.posts.map(p=>`<option value="${p.id}">#${p.id} — ${esc(p.content.slice(0,75))}</option>`).join("")
      || `<option value="">No posts available</option>`
    }
   </select>

   <select name="connector_id" required>
    ${
      S.connectors.map(c=>`<option value="${c.id}">#${c.id} — ${esc(c.account_name)} (${esc(c.platform)})</option>`).join("")
      || `<option value="">No connected accounts</option>`
    }
   </select>

   <input name="scheduled_at" required placeholder="YYYY-MM-DD HH:MM:SS">

   <p class="muted">
    Use a future UTC time for normal scheduled publishing.
   </p>

   <div class="toolbar">
    <button class="primary">Create Job</button>
    <button type="button" class="ghost cancel">Cancel</button>
   </div>
  </form>
 </div>

 <div class="panel">
  <table>
   <thead>
    <tr><th>ID</th><th>Post</th><th>Connector</th><th>Scheduled</th><th>Status</th><th>Error</th></tr>
   </thead>
   <tbody>
    ${
      S.jobs.map(x=>`
      <tr>
       <td>#${x.id}</td>
       <td>#${x.post_id}</td>
       <td>#${x.connector_id}</td>
       <td>${esc(x.scheduled_at)}</td>
       <td><span class="status">${esc(x.status)}</span></td>
       <td>${esc(x.last_error||"")}</td>
      </tr>`).join("")
      || `<tr><td colspan="6" class="empty">No scheduler jobs</td></tr>`
    }
   </tbody>
  </table>
 </div>`;
}

function analytics(){
 const total=S.jobs.length;
 const pub=S.jobs.filter(x=>x.status==="published").length;
 const fail=S.jobs.filter(x=>x.status==="failed").length;
 const pending=S.jobs.filter(x=>x.status==="pending").length;
 const rate=total?Math.round(pub/total*100):0;

 const platforms=[...new Set(S.connectors.map(x=>x.platform))];

 return `
 <h2>Analytics</h2>
 <div class="cards">
  <div class="card"><span>Total Jobs</span><strong>${total}</strong></div>
  <div class="card"><span>Published</span><strong>${pub}</strong></div>
  <div class="card"><span>Failed</span><strong>${fail}</strong></div>
  <div class="card"><span>Success Rate</span><strong>${rate}%</strong></div>
 </div>

 <div class="grid2" style="margin-top:15px">
  <div class="panel">
   <h3>Platform Activity</h3>
   ${
     platforms.map(p=>`
      <p>${esc(p)} — ${S.jobs.filter(j=>{
        const c=S.connectors.find(c=>c.id===j.connector_id);
        return c?.platform===p && j.status==="published";
      }).length} published</p>`).join("")
     || `<p class="muted">No connected platform activity yet.</p>`
   }
  </div>

  <div class="panel">
   <h3>Queue State</h3>
   <p class="ok">Published: ${pub}</p>
   <p class="warn">Pending: ${pending}</p>
   <p class="bad-text">Failed: ${fail}</p>
  </div>
 </div>`;
}

function notifications(){
 const failed=S.jobs.filter(x=>x.status==="failed");
 const pending=S.jobs.filter(x=>x.status==="pending");
 const inactive=S.connectors.filter(x=>x.status!=="connected");

 return `
 <h2>Notifications</h2>
 <div class="panel">
  ${
    failed.map(x=>`<p class="bad-text">Job #${x.id} failed: ${esc(x.last_error||"publish_failed")}</p>`).join("")
  }
  ${
    pending.map(x=>`<p class="warn">Job #${x.id} is pending.</p>`).join("")
  }
  ${
    inactive.map(x=>`<p class="warn">Connector #${x.id} is ${esc(x.status)}.</p>`).join("")
  }
  ${
    !failed.length&&!pending.length&&!inactive.length
      ? `<p class="ok">No active system notifications.</p>`
      : ""
  }
 </div>`;
}

function settings(){
 const ws=S.settings.workspace||"NAYEM BOSS SOCIAL AUTOMATION";
 const tz=S.settings.timezone||"Asia/Dhaka";
 const refresh=S.settings.refresh||30;

 return `
 <h2>Settings</h2>

 <div class="panel form-panel">
  <form id="settingsForm">
   <label class="muted">Workspace display name</label>
   <input name="workspace" value="${esc(ws)}">

   <label class="muted">Timezone</label>
   <select name="timezone">
    <option ${tz==="Asia/Dhaka"?"selected":""}>Asia/Dhaka</option>
    <option ${tz==="UTC"?"selected":""}>UTC</option>
   </select>

   <label class="muted">Dashboard refresh interval (seconds)</label>
   <input name="refresh" type="number" min="10" value="${esc(refresh)}">

   <div class="toolbar">
    <button class="primary">Save</button>
    <button type="button" id="resetSettings" class="ghost">Reset</button>
   </div>
  </form>
 </div>

 <div class="panel">
  <p class="muted">These are browser-side dashboard preferences. Server automation settings are controlled by the backend.</p>
  <p class="muted">API: ${API}</p>
 </div>`;
}

function users(){
 return `
 <h2>Admin Users</h2>
 <div class="panel">
  <table>
   <thead><tr><th>ID</th><th>Email</th><th>Role</th><th>Active</th><th>Created</th></tr></thead>
   <tbody>
   ${
    S.users.map(u=>`
     <tr>
      <td>#${u.id}</td>
      <td>${esc(u.email)}</td>
      <td>${esc(u.role)}</td>
      <td>${u.is_active?"Yes":"No"}</td>
      <td>${esc(u.created_at)}</td>
     </tr>`).join("")
    || `<tr><td colspan="5" class="empty">No users</td></tr>`
   }
   </tbody>
  </table>
 </div>`;
}

async function authenticate(form,register){
 const f=new FormData(form);
 const data=await api(register?"/api/auth/register":"/api/auth/login",{
   method:"POST",
   body:json({
     email:f.get("email"),
     password:f.get("password")
   })
 });

 if(!data.token) throw new Error("Server did not return a session token.");

 S.token=data.token;
 localStorage.setItem("nbsa_token",S.token);

 await loadAll();
 render();
 toast(register?"Workspace created":"Login successful");
}

async function readImageAsDataURL(file){
 return await new Promise((resolve,reject)=>{
   const reader=new FileReader();
   reader.onload=()=>resolve(String(reader.result||""));
   reader.onerror=()=>reject(new Error("Could not read the image"));
   reader.readAsDataURL(file);
 });
}

async function createPost(form){
 const f=new FormData(form);
 const content=String(f.get("content")||"").trim();
 const file=f.get("media_file");

 if(!content && !(file instanceof File && file.size)){
   throw new Error("Write text or attach a photo");
 }

 let media=null;

 if(file instanceof File && file.size){
   if(!file.type.startsWith("image/")){
     throw new Error("Please choose an image file");
   }

   if(file.size>5*1024*1024){
     throw new Error("Photo must be 5 MB or smaller");
   }

   media=await readImageAsDataURL(file);
 }

 await api("/api/posts",{
   method:"POST",
   body:json({
    content,
    media,
    status:f.get("status"),
    scheduled_at:String(f.get("scheduled_at")||"").trim()||null
   })
 });

 await loadAll();
 render();
 toast(media?"Post with photo created":"Text post created");
}

async function createCampaign(form){
 const f=new FormData(form);

 await api("/api/campaigns",{
   method:"POST",
   body:json({
     name:String(f.get("name")||"").trim(),
     status:f.get("status")
   })
 });

 await loadAll();
 render();
 toast("Campaign created");
}

async function createWebsite(form){
 const f=new FormData(form);

 await api("/api/oauth/connectors",{
   method:"POST",
   body:json({
     platform:"website",
     account_name:String(f.get("account_name")||"").trim(),
     webhook_url:String(f.get("webhook_url")||"").trim()
   })
 });

 await loadAll();
 render();
 toast("Website connector saved");
}

async function createJob(form){
 const f=new FormData(form);

 const postId=Number(f.get("post_id"));
 const connectorId=Number(f.get("connector_id"));
 const at=String(f.get("scheduled_at")||"").trim();

 if(!postId||!connectorId||!at) throw new Error("Post, connector and schedule time are required.");

 await api("/api/scheduler/jobs",{
   method:"POST",
   body:json({
     post_id:postId,
     connector_id:connectorId,
     scheduled_at:at
   })
 });

 await loadAll();
 render();
 toast("Scheduler job created");
}

function bind(){
 $("#logout")?.addEventListener("click",()=>logout());

 $("#refresh")?.addEventListener("click",async()=>{
   try{
     await loadAll();
     render();
     toast("Data refreshed");
   }catch(e){toast(e.message,false)}
 });

 document.querySelectorAll("[data-view]").forEach(b=>{
   b.addEventListener("click",()=>{
     S.view=b.dataset.view;
     render();
   });
 });

 $("#loginForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await authenticate(e.target,false)}
   catch(x){$("#authError").textContent=x.message}
 });

 $("#registerForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await authenticate(e.target,true)}
   catch(x){$("#authError").textContent=x.message}
 });

 $("#showPost")?.addEventListener("click",()=>$("#postBox").classList.remove("hidden"));
 $("#showCampaign")?.addEventListener("click",()=>$("#campaignBox").classList.remove("hidden"));
 $("#showWebsite")?.addEventListener("click",()=>$("#websiteBox").classList.remove("hidden"));
 $("#showJob")?.addEventListener("click",()=>$("#jobBox").classList.remove("hidden"));

 document.querySelectorAll(".cancel").forEach(b=>{
   b.addEventListener("click",()=>b.closest(".form-panel")?.classList.add("hidden"));
 });

 $("#postForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await createPost(e.target)}
   catch(x){toast(x.message,false)}
 });

 $("#mediaFile")?.addEventListener("change",e=>{
   const file=e.target.files?.[0];
   const box=$("#mediaPreview");
   const img=box?.querySelector("img");

   if(!box||!img)return;

   if(!file){
     box.classList.add("hidden");
     img.removeAttribute("src");
     return;
   }

   if(!file.type.startsWith("image/")||file.size>5*1024*1024){
     box.classList.add("hidden");
     img.removeAttribute("src");
     return;
   }

   const reader=new FileReader();
   reader.onload=()=>{img.src=String(reader.result||"");box.classList.remove("hidden")};
   reader.readAsDataURL(file);
 });

 $("#campaignForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await createCampaign(e.target)}
   catch(x){toast(x.message,false)}
 });

 $("#websiteForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await createWebsite(e.target)}
   catch(x){toast(x.message,false)}
 });

 $("#jobForm")?.addEventListener("submit",async e=>{
   e.preventDefault();
   try{await createJob(e.target)}
   catch(x){toast(x.message,false)}
 });

 document.querySelectorAll(".deletePost").forEach(b=>{
   b.addEventListener("click",async()=>{
     if(!confirm("Delete this post?"))return;
     try{
       await api("/api/posts/"+b.dataset.id,{method:"DELETE"});
       await loadAll();
       render();
       toast("Post deleted");
     }catch(x){toast(x.message,false)}
   });
 });

 document.querySelectorAll(".deleteCampaign").forEach(b=>{
   b.addEventListener("click",async()=>{
     if(!confirm("Delete this campaign?"))return;
     try{
       await api("/api/campaigns/"+b.dataset.id,{method:"DELETE"});
       await loadAll();
       render();
       toast("Campaign deleted");
     }catch(x){toast(x.message,false)}
   });
 });

 document.querySelectorAll(".oauthInfo").forEach(b=>{
   b.addEventListener("click",()=>{
     openOAuthNotice(b.dataset.platform);
   });
 });

 $("#settingsForm")?.addEventListener("submit",e=>{
   e.preventDefault();
   const f=new FormData(e.target);

   S.settings={
     workspace:String(f.get("workspace")||"").trim()||"NAYEM BOSS SOCIAL AUTOMATION",
     timezone:String(f.get("timezone")||"Asia/Dhaka"),
     refresh:Math.max(10,Number(f.get("refresh"))||30)
   };

   localStorage.setItem("nbsa_settings",JSON.stringify(S.settings));
   toast("Dashboard settings saved");
 });

 $("#resetSettings")?.addEventListener("click",()=>{
   S.settings={};
   localStorage.removeItem("nbsa_settings");
   render();
   toast("Dashboard settings reset");
 });
}

function openOAuthNotice(platform){
 const label=platform[0].toUpperCase()+platform.slice(1);

 document.body.insertAdjacentHTML("beforeend",`
 <div id="oauthModal" class="overlay">
  <div class="modal">
   <h3>${esc(label)} connection</h3>
   <p class="muted">
    Manual access-token entry is intentionally disabled.
   </p>
   <div class="note">
    This platform requires its official OAuth connector to be configured on the backend
    before an account can be marked connected.
   </div>
   <p class="muted">
    No fake connection will be created and no token will be requested from the user here.
   </p>
   <div class="toolbar">
    <button id="closeOAuth" class="primary">Close</button>
   </div>
  </div>
 </div>`);

 $("#closeOAuth")?.addEventListener("click",()=>$("#oauthModal")?.remove());
}

function render(){
 document.body.innerHTML=`<div id="app">${S.token&&S.me?shell():authPage()}</div>`;
 bind();
}

(async()=>{
 if(S.token){
   try{
     await loadAll();
   }catch{
     S.token="";
     S.me=null;
     localStorage.removeItem("nbsa_token");
   }
 }
 render();
})();
</script>
</body>
</html>
