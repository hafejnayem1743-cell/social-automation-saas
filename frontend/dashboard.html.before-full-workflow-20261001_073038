function bind(){

 $("#logout")?.addEventListener("click",()=>logout());

 $("#refresh")?.addEventListener("click",async()=>{
  try{await loadAll();render();toast("Data refreshed")}
  catch(x){toast(x.message,false)}
 });

 document.querySelectorAll("[data-view]").forEach(b=>{
  b.addEventListener("click",()=>{
   S.view=b.dataset.view;
   render();
  });
 });

 // Platform -> target visibility.
 document.querySelectorAll("[data-platform-select]").forEach(cb=>{
  cb.addEventListener("change",()=>{
   const group=document.querySelector(`[data-group="${cb.dataset.platformSelect}"]`);
   if(group)group.hidden=!cb.checked;
  });
 });

 // Target selection automatically selects its platform.
 document.querySelectorAll('input[name="composer_target"]').forEach(cb=>{
  cb.addEventListener("change",()=>{
   if(!cb.checked)return;
   const p=cb.dataset.targetPlatform;
   const platform=document.querySelector(`[data-platform-select="${p}"]`);
   const group=document.querySelector(`[data-group="${p}"]`);
   if(platform)platform.checked=true;
   if(group)group.hidden=false;
  });
 });

 // Action.
 document.querySelectorAll(".actionBtn").forEach(b=>{
  b.addEventListener("click",()=>{
   document.querySelectorAll(".actionBtn").forEach(x=>x.classList.remove("active"));
   b.classList.add("active");
   $("#composerAction").value=b.dataset.action;
  });
 });

 // Mode.
 document.querySelectorAll(".modeBtn").forEach(b=>{
  b.addEventListener("click",()=>{
   document.querySelectorAll(".modeBtn").forEach(x=>x.classList.remove("active"));
   b.classList.add("active");
   $("#composerMode").value=b.dataset.mode;
  });
 });

 // Photo preview.
 $("#mediaFile")?.addEventListener("change",e=>{
  const file=e.target.files?.[0];
  const box=$("#mediaPreview");
  const img=box?.querySelector("img");

  if(!box||!img)return;

  if(!file){
   box.hidden=true;
   img.removeAttribute("src");
   return;
  }

  if(!file.type.startsWith("image/")){
   toast("Please select an image",false);
   e.target.value="";
   box.hidden=true;
   return;
  }

  if(file.size>5*1024*1024){
   toast("Photo must be 5 MB or smaller",false);
   e.target.value="";
   box.hidden=true;
   return;
  }

  const reader=new FileReader();
  reader.onload=()=>{
   img.src=String(reader.result||"");
   box.hidden=false;
  };
  reader.readAsDataURL(file);
 });

 // Add target inline.
 $("#quickTarget")?.addEventListener("click",()=>{
  $("#quickTargetBox")?.removeAttribute("hidden");
 });

 $(".cancelQuickTarget")?.addEventListener("click",()=>{
  $("#quickTargetBox")?.setAttribute("hidden","");
 });

 $("#quickTargetForm")?.addEventListener("submit",async e=>{
  e.preventDefault();

  try{
   const f=new FormData(e.target);
   const option=$("#quickConnector")?.selectedOptions?.[0];
   const platform=option?.dataset.platform||"";

   if(!platform)throw new Error("Connector platform is missing");

   await api("/api/targets",{
    method:"POST",
    body:JSON.stringify({
     connector_id:Number(f.get("connector_id")),
     platform,
     target_type:f.get("target_type"),
     target_input:String(f.get("target_input")||"").trim(),
     target_name:String(f.get("target_name")||"").trim()||null,
     platform_target_id:String(f.get("platform_target_id")||"").trim()||null
    })
   });

   await loadAll();
   render();
   toast("Target saved");
  }catch(x){toast(x.message,false)}
 });

 // Main composer.
 $("#postForm")?.addEventListener("submit",async e=>{
  e.preventDefault();

  const err=$("#composerError");
  if(err)err.textContent="";

  try{
   const f=new FormData(e.target);
   const mode=f.get("mode")||"draft";
   const action=f.get("action")||"publish";
   const content=String(f.get("content")||"").trim();
   const file=f.get("media_file");

   if(!content && !(file instanceof File&&file.size)){
    throw new Error("Add text or a photo");
   }

   let media=null;

   if(file instanceof File&&file.size){
    if(!file.type.startsWith("image/"))throw new Error("Only image files are supported");
    if(file.size>5*1024*1024)throw new Error("Photo must be 5 MB or smaller");

    media=await new Promise((resolve,reject)=>{
     const r=new FileReader();
     r.onload=()=>resolve(String(r.result||""));
     r.onerror=()=>reject(new Error("Could not read the photo"));
     r.readAsDataURL(file);
    });
   }

   // Save actual content first.
   const post=await api("/api/posts",{
    method:"POST",
    body:JSON.stringify({
     content,
     media,
     status:"draft",
     scheduled_at:null
    })
   });

   if(mode==="draft"){
    await loadAll();
    render();
    toast("Draft saved");
    return;
   }

   const targets=[
    ...e.target.querySelectorAll('input[name="composer_target"]:checked')
   ].map(x=>Number(x.value));

   if(!targets.length)throw new Error("Select at least one target");

   const selectedPlatforms=[
    ...e.target.querySelectorAll('input[name="composer_platform"]:checked')
   ].map(x=>x.value);

   if(!selectedPlatforms.length)throw new Error("Select at least one platform");

   let scheduledAt;

   if(mode==="schedule"){
    const value=String(f.get("scheduled_at")||"").trim();
    if(!value)throw new Error("Choose a date and time");
    scheduledAt=value.replace("T"," ")+":00";
   }else{
    const d=new Date();
    const pad=n=>String(n).padStart(2,"0");
    scheduledAt=
      `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`+
      ` ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
   }

   const result=await api("/api/automations",{
    method:"POST",
    body:JSON.stringify({
     name:String(f.get("name")||"NBSA Automation").trim()||"NBSA Automation",
     post_id:Number(post.id),
     action,
     target_ids:targets,
     scheduled_at:scheduledAt,
     recurring_rule:null
    })
   });

   await loadAll();
   render();
   toast(`${mode==="now"?"Publish":"Schedule"} created for ${result.targets_created} target(s)`);

  }catch(x){
   if(err)err.textContent=x.message;
   toast(x.message,false);
  }
 });

