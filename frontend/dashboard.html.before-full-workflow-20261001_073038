function analytics(){
 const total=S.jobs.length;
 const pub=S.jobs.filter(x=>x.status==="published").length;
 const fail=S.jobs.filter(x=>x.status==="failed").length;
 const pending=S.jobs.filter(x=>x.status==="pending").length;
 const rate=total?Math.round(pub/total*100):0;

 const platforms=[...new Set(S.connectors.map(x=>x.platform))];

 return `
 <h2>Analytics</h2>
 <div class="cards">
  <div class="card"><span>Total Jobs</span><strong>${total}</strong></div>
  <div class="card"><span>Published</span><strong>${pub}</strong></div>
  <div class="card"><span>Failed</span><strong>${fail}</strong></div>
  <div class="card"><span>Success Rate</span><strong>${rate}%</strong></div>
 </div>

 <div class="grid2" style="margin-top:15px">
  <div class="panel">
   <h3>Platform Activity</h3>
   ${
     platforms.map(p=>`
      <p>${esc(p)} — ${S.jobs.filter(j=>{
        const c=S.connectors.find(c=>c.id===j.connector_id);
        return c?.platform===p && j.status==="published";
      }).length} published</p>`).join("")
     || `<p class="muted">No connected platform activity yet.</p>`
   }
  </div>

  <div class="panel">
   <h3>Queue State</h3>
   <p class="ok">Published: ${pub}</p>
   <p class="warn">Pending: ${pending}</p>
   <p class="bad-text">Failed: ${fail}</p>
  </div>
 </div>`;
}

function notifications(){
 const failed=S.jobs.filter(x=>x.status==="failed");
 const pending=S.jobs.filter(x=>x.status==="pending");
 const inactive=S.connectors.filter(x=>x.status!=="connected");

 return `
 <h2>Notifications</h2>
 <div class="panel">
  ${
    failed.map(x=>`<p class="bad-text">Job #${x.id} failed: ${esc(x.last_error||"publish_failed")}</p>`).join("")
  }
  ${
    pending.map(x=>`<p class="warn">Job #${x.id} is pending.</p>`).join("")
  }
  ${
    inactive.map(x=>`<p class="warn">Connector #${x.id} is ${esc(x.status)}.</p>`).join("")
  }
  ${
    !failed.length&&!pending.length&&!inactive.length
      ? `<p class="ok">No active system notifications.</p>`
      : ""
  }
 </div>`;
}

