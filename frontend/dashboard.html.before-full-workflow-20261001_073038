<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NAYEM BOSS SOCIAL AUTOMATION</title>

<style>
:root{
  --bg:#07111d;--panel:#0d1928;--panel2:#122238;--line:#263b54;
  --text:#edf5ff;--muted:#91a5bc;--accent:#4de0bf;
  --danger:#ff718d;--warn:#ffd166;--white:#fff
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
body{overflow-x:hidden}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.5;cursor:not-allowed}
.auth{min-height:100vh;display:grid;place-items:center;padding:22px}
.auth-card{width:min(450px,100%);background:var(--panel);border:1px solid var(--line);
border-radius:24px;padding:32px;box-shadow:0 30px 100px #0008}
.logo{font-weight:900;letter-spacing:.14em;color:var(--accent)}
.auth-title{font-size:29px;line-height:1.12;margin:12px 0 8px}
.muted{color:var(--muted)}
.error{color:var(--danger);min-height:20px}
input,select,textarea{
 width:100%;margin:7px 0;padding:12px 13px;background:#081320;color:var(--text);
 border:1px solid var(--line);border-radius:11px;outline:0
}
textarea{min-height:120px;resize:vertical}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
.primary,.ghost,.danger{
 padding:10px 14px;border-radius:10px;border:1px solid var(--line)
}
.primary{background:var(--accent);color:#03130f;border-color:var(--accent);font-weight:800}
.ghost{background:transparent;color:var(--text)}
.danger{background:transparent;color:var(--danger);border-color:#6b2638}
.divider{text-align:center;color:var(--muted);padding:13px}
.app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}
aside{background:#081320;border-right:1px solid var(--line);padding:20px;
display:flex;flex-direction:column;gap:18px}
.brand small{display:block;color:var(--muted);letter-spacing:.09em;margin-top:3px}
nav{display:flex;flex-direction:column;gap:4px}
nav button{border:0;background:transparent;color:var(--muted);padding:11px 12px;
border-radius:10px;text-align:left}
nav button:hover,nav button.active{background:var(--panel2);color:var(--text)}
.logout{margin-top:auto;width:100%}
main{min-width:0}
header{height:70px;border-bottom:1px solid var(--line);display:flex;
align-items:center;justify-content:space-between;padding:0 24px;background:#0a1523;gap:14px}
.userline{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge,.status{border:1px solid var(--line);border-radius:999px;padding:4px 8px;
font-size:11px;color:var(--muted)}
.content{max-width:1380px;margin:auto;padding:24px}
.title-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px}
.card span{color:var(--muted);font-size:13px}.card strong{display:block;font-size:32px;margin-top:5px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.form-panel{max-width:820px;margin-bottom:16px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.panel{overflow:auto}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:11px;color:var(--muted);text-transform:uppercase}
.empty{padding:20px;text-align:center;color:var(--muted)}
.small{padding:8px 11px}
.ok{color:var(--accent)}.warn{color:var(--warn)}.bad-text{color:var(--danger)}
.note{padding:12px 14px;background:#0b1725;border:1px solid var(--line);border-radius:12px}
.connector-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.connector{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px}
.connector h3{margin:0 0 7px}.connector p{color:var(--muted);font-size:13px;min-height:34px}
.overlay{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:18px;z-index:200}
.modal{width:min(600px,100%);background:var(--panel);border:1px solid var(--line);
border-radius:18px;padding:20px}
.hidden{display:none!important}
.toast{position:fixed;right:17px;bottom:17px;z-index:300;padding:12px 15px;border-radius:11px;
background:var(--panel2);border:1px solid var(--line)}
.toast.good{border-color:#176b59}.toast.bad{border-color:#7f2940}
.search{max-width:300px}
hr{border:0;border-top:1px solid var(--line);margin:18px 0}
@media(max-width:1000px){
 .app{grid-template-columns:1fr}
 aside{border-right:0;border-bottom:1px solid var(--line)}
 nav{flex-direction:row;overflow:auto}
 nav button{white-space:nowrap}
 .cards{grid-template-columns:repeat(2,1fr)}
 .connector-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:650px){
 .content{padding:14px}.cards,.grid2,.grid3,.connector-grid{grid-template-columns:1fr}
 header{padding:0 14px}
 .search{display:none}
}

.composerPanel{padding:18px}
.composerSection{border:1px solid var(--line);border-radius:13px;padding:16px;margin-bottom:14px;background:#07131e}
.sectionHead{display:flex;align-items:center;gap:10px;margin-bottom:11px}
.sectionHead>span{font-family:ui-monospace,monospace;color:var(--cy-cyan);font-weight:800}
.sectionHead h3{margin:0}
.platformGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.platformChoice,.targetChoice{display:flex;align-items:center;gap:8px;padding:10px;border:1px solid var(--line);border-radius:9px;background:#081522}
.platformChoice input,.targetChoice input{width:auto;margin:0}
.targetGroups{display:grid;gap:9px;max-height:300px;overflow:auto;margin-top:11px}
.targetGroup{border:1px solid var(--line);border-radius:10px;padding:10px}
.groupTitle{font-weight:800;color:var(--cy-cyan);margin-bottom:7px}
.actionGrid{display:flex;gap:9px;flex-wrap:wrap}
.actionBtn.active,.modeBtn.active{box-shadow:0 0 18px rgba(40,243,255,.22)}
.scheduleGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.quickTargetBox{margin-top:11px;padding:13px;border:1px solid var(--line);border-radius:11px;background:#06111a}
.previewImage{max-width:320px;max-height:240px;border-radius:11px;border:1px solid var(--line)}
@media(max-width:850px){.platformGrid,.scheduleGrid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.platformGrid,.scheduleGrid{grid-template-columns:1fr}}
</style>
<link rel="stylesheet" href="/cyber.css"></head>

<body>
<script>
if(!localStorage.getItem("nbsa_token") && location.pathname==="/"){
  location.replace("/login.html");
}
</script>
<div id="app"></div>

<script>
const API="http://127.0.0.1:8000";

const S={
 token:localStorage.getItem("nbsa_token")||"",
 me:null,
 view:"overview",
 posts:[],
 campaigns:[],
 connectors:[],
 jobs:[],
 users:[],
 status:null,
 settings:JSON.parse(localStorage.getItem("nbsa_settings")||"{}")
};

const $=(s,r=document)=>r.querySelector(s);

function esc(v){
 return String(v??"").replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
 }[c]));
}

function json(v){return JSON.stringify(v)}

function toast(msg,good=true){
 const x=document.createElement("div");
 x.className="toast "+(good?"good":"bad");
 x.textContent=msg;
 document.body.appendChild(x);
 setTimeout(()=>x.remove(),2800);
}

async function api(path,opt={}){
 const headers={...(opt.headers||{})};
 if(opt.body && !headers["Content-Type"]) headers["Content-Type"]="application/json";
 if(S.token) headers.Authorization="Bearer "+S.token;

 let r;
 try{
   r=await fetch(API+path,{...opt,headers});
 }catch(e){
   throw new Error("API connection failed. Is the backend running?");
 }

 const text=await r.text();
 let d={};
 try{d=text?JSON.parse(text):{}}catch{d={detail:text||"Invalid server response"}}

 if(r.status===401){
   logout(false);
   throw new Error(d.detail||"Authentication required");
 }
 if(!r.ok) throw new Error(d.detail||d.message||("HTTP "+r.status));
 return d;
}

async function loadAll(){
 const [me,p,c,a,j,st,t,au]=await Promise.all([
  api("/api/me"),
  api("/api/posts"),
  api("/api/campaigns"),
  api("/api/oauth/connectors"),
  api("/api/scheduler/jobs"),
  api("/api/status"),
  api("/api/targets"),
  api("/api/automations")
 ]);

 S.me=me.user;
 S.posts=p.posts||[];
 S.campaigns=c.campaigns||[];
 S.connectors=a.connectors||[];
 S.jobs=j.jobs||[];
 S.status=st;
 S.targets=t.targets||[];
 S.automations=au.automations||[];

 if(S.me.role==="owner"||S.me.role==="admin"){
  const u=await api("/api/admin/users");
  S.users=u.users||[];
 }
}

function logout(show=true){
 S.token="";
 S.me=null;
 localStorage.removeItem("nbsa_token");
 render();
 if(show)toast("Logged out");
}

function authPage(){
 return `
 <div class="auth">
   <div class="auth-card">
     <div class="logo">NBSA</div>
     <div class="auth-title">NAYEM BOSS SOCIAL AUTOMATION</div>
     <p class="muted">Automation workspace</p>

     <form id="loginForm">
       <input name="email" type="email" required placeholder="Email">
       <input name="password" type="password" required placeholder="Password">
       <button class="primary" style="width:100%">Login</button>
     </form>

     <div class="divider">or create a new workspace</div>

     <form id="registerForm">
       <input name="email" type="email" required placeholder="Email">
       <input name="password" type="password" minlength="8" required placeholder="Password (8+ characters)">
       <button class="ghost" style="width:100%">Register</button>
     </form>

     <p id="authError" class="error"></p>
   </div>
 </div>`;
}

function nav(id,label){
 return `<button data-view="${id}" class="${S.view===id?"active":""}">${label}</button>`;
}

function shell(){
 const admin=S.me?.role==="owner"||S.me?.role==="admin";

 return `
 <div class="app">
   <aside>
     <div class="brand">
       <div class="logo">NBSA</div>
       <small>SOCIAL AUTOMATION</small>
     </div>

     <nav>
       ${nav("overview","Overview")}
       ${nav("posts","Posts")}
       ${nav("campaigns","Campaigns")}
       ${nav("connectors","Social Accounts")}
       ${nav("scheduler","Scheduler")}
       ${nav("targets","Targets")}
       ${nav("automations","Automations")}
       ${nav("analytics","Analytics")}
       ${nav("notifications","Notifications")}
       ${nav("settings","Settings")}
       ${admin?nav("users","Admin Users"):""}
     </nav>

     <button id="logout" class="ghost logout">Logout</button>
   </aside>

   <main>
     <header>
       <div class="userline">
         <b>${esc(S.me?.email)}</b>
         <span class="badge">${esc(S.me?.role)}</span>
       </div>
       <button id="refresh" class="ghost small">Refresh</button>
     </header>

     <div class="content">${view()}</div>
   </main>
 </div>`;
}

function view(){
 switch(S.view){
   case "posts":return posts();
   case "campaigns":return campaigns();
   case "connectors":return connectors();
   case "scheduler":return scheduler();
   case "analytics":return analytics();
   case "notifications":return notifications();
   case "settings":return settings();
   case "users":return users();
   default:return overview();
 }
}

function overview(){
 const published=S.jobs.filter(x=>x.status==="published").length;
 const failed=S.jobs.filter(x=>x.status==="failed").length;
 const pending=S.jobs.filter(x=>x.status==="pending").length;

 return `
 <h2>Overview</h2>

 <div class="cards">
   <div class="card"><span>Posts</span><strong>${S.posts.length}</strong></div>
   <div class="card"><span>Campaigns</span><strong>${S.campaigns.length}</strong></div>
   <div class="card"><span>Connected Accounts</span><strong>${S.connectors.length}</strong></div>
   <div class="card"><span>Published Jobs</span><strong>${published}</strong></div>
 </div>

 <div class="grid3" style="margin-top:15px">
   <div class="panel">
     <h3>Worker</h3>
     <p class="ok">${esc(S.status?.worker||"unknown")}</p>
     <p class="muted">Pending jobs: ${pending}</p>
     <p class="muted">API: ${esc(S.status?.version||"-")}</p>
   </div>

   <div class="panel">
     <h3>Publishing</h3>
     <p class="ok">Published: ${published}</p>
     <p class="bad-text">Failed: ${failed}</p>
   </div>

   <div class="panel">
     <h3>Workspace</h3>
     <p>Tenant #${esc(S.me?.tenant_id)}</p>
     <p class="muted">User #${esc(S.me?.id)}</p>
     <p class="muted">Role: ${esc(S.me?.role)}</p>
   </div>
 </div>

 <div class="panel" style="margin-top:15px">
   <h3>Current system state</h3>
   <p class="muted">All counts above come from the current API/database response. No demo counters are inserted.</p>
 </div>`;
}

function posts(){
 const platforms=[
  ["facebook","Facebook"],
  ["instagram","Instagram"],
  ["telegram","Telegram"],
  ["x","X"],
  ["youtube","YouTube"],
  ["tiktok","TikTok"],
  ["pinterest","Pinterest"],
  ["reddit","Reddit"]
 ];

 const groups=platforms.map(([key,label])=>{
  const targets=S.targets.filter(t=>t.platform===key&&t.status==="active");

  return `<div class="targetGroup" data-group="${key}" hidden>
   <div class="groupTitle">${label}</div>
   ${
    targets.map(t=>`
     <label class="targetChoice">
      <input type="checkbox" name="composer_target" value="${t.id}" data-target-platform="${key}">
      <span><b>${esc(t.target_name||t.target_input)}</b>
      <span class="muted"> · ${esc(t.target_input)}</span></span>
     </label>
    `).join("")
    || `<div class="muted">No saved ${label} target.</div>`
   }
  </div>`;
 }).join("");

 return `
 <div class="title-row">
  <div>
   <h2>New Post</h2>
   <div class="muted">Text + Photo → Platform → Target → Action → Schedule</div>
  </div>
 </div>

 <div class="panel composerPanel">
  <form id="postForm">

   <section class="composerSection">
    <div class="sectionHead"><span>01</span><h3>Content</h3></div>

    <textarea name="content" placeholder="Write your post text..."></textarea>

    <label class="muted">Photo / Image</label>
    <input id="mediaFile" name="media_file" type="file" accept="image/*">

    <div id="mediaPreview" hidden style="margin-top:10px">
     <img class="previewImage">
    </div>
   </section>

   <section class="composerSection">
    <div class="sectionHead"><span>02</span><h3>Platforms</h3></div>

    <div class="platformGrid">
     ${
      platforms.map(([key,label])=>`
       <label class="platformChoice">
        <input type="checkbox" name="composer_platform" value="${key}" data-platform-select="${key}">
        <span>${label}</span>
       </label>
      `).join("")
     }
    </div>
   </section>

   <section class="composerSection">
    <div class="sectionHead"><span>03</span><h3>Targets</h3></div>

    <div class="note">
     Choose one or many authorized targets. A target can be stored by username, @handle, name or platform ID.
    </div>

    <div class="targetGroups">
     ${groups}
    </div>

    <button type="button" id="quickTarget" class="ghost addTargetBtn">+ Add Target</button>

    <div id="quickTargetBox" hidden class="quickTargetBox">
     <h3>Add Target</h3>

     ${
      S.connectors.length
      ? `
       <form id="quickTargetForm">

        <select name="connector_id" id="quickConnector" required>
         ${S.connectors.map(c=>`
          <option value="${c.id}" data-platform="${esc(c.platform)}">
           #${c.id} · ${esc(c.account_name)} · ${esc(c.platform)}
          </option>
         `).join("")}
        </select>

        <select name="target_type">
         <option value="destination">Destination</option>
         <option value="page">Page</option>
         <option value="account">Account</option>
         <option value="channel">Channel</option>
         <option value="group">Group</option>
         <option value="post">Post</option>
         <option value="video">Video</option>
         <option value="comment">Comment</option>
         <option value="subreddit">Subreddit</option>
        </select>

        <input name="target_input" required placeholder="@username / @handle / name / ID">
        <input name="target_name" placeholder="Display name (optional)">
        <input name="platform_target_id" placeholder="Resolved official platform ID (optional)">

        <div class="toolbar">
         <button class="primary">Save Target</button>
         <button type="button" class="ghost cancelQuickTarget">Cancel</button>
        </div>

       </form>
      `
      : `<div class="muted">No connected account available yet.</div>`
     }
    </div>
   </section>

   <section class="composerSection">
    <div class="sectionHead"><span>04</span><h3>Action</h3></div>

    <div class="actionGrid">
     <button type="button" class="ghost active actionBtn" data-action="publish">Publish</button>
     <button type="button" class="ghost actionBtn" data-action="comment">Comment</button>
     <button type="button" class="ghost actionBtn" data-action="reply">Reply</button>
    </div>

    <input type="hidden" name="action" id="composerAction" value="publish">
   </section>

   <section class="composerSection">
    <div class="sectionHead"><span>05</span><h3>Schedule</h3></div>

    <div class="scheduleGrid">
     <div>
      <label class="muted">Automation name</label>
      <input name="name" value="NBSA Automation">
     </div>
     <div>
      <label class="muted">Date & Time</label>
      <input name="scheduled_at" type="datetime-local">
     </div>
    </div>

    <div class="actionGrid" style="margin-top:12px">
     <button type="button" class="ghost modeBtn active" data-mode="draft">Save Draft</button>
     <button type="button" class="primary modeBtn" data-mode="now">Publish Now</button>
     <button type="button" class="primary modeBtn" data-mode="schedule">Schedule</button>
    </div>

    <input type="hidden" name="mode" id="composerMode" value="draft">

    <p id="composerError" class="error"></p>
   </section>

  </form>
 </div>

 <div class="panel">
  <div class="title-row">
   <div>
    <h3>Posts</h3>
    <div class="muted">Real database records only</div>
   </div>
   <span class="badge">${S.posts.length} total</span>
  </div>

  <div class="table-wrap">
   <table>
    <thead>
     <tr><th>ID</th><th>Content</th><th>Media</th><th>Status</th><th>Created</th><th>Action</th></tr>
    </thead>
    <tbody>
     ${
      S.posts.map(p=>`
       <tr>
        <td>#${p.id}</td>
        <td>${esc(p.content||"")}</td>
        <td>${p.media_data?"📷 Photo":"-"}</td>
        <td><span class="status">${esc(p.status)}</span></td>
        <td>${esc(p.created_at)}</td>
        <td><button class="danger deletePost" data-id="${p.id}">Delete</button></td>
       </tr>
      `).join("")
      || `<tr><td colspan="6" class="empty">No posts yet.</td></tr>`
     }
    </tbody>
   </table>
  </div>
 </div>`;
}

function campaigns(){
 return `
 <div class="title-row">
   <h2>Campaigns</h2>
   <button id="showCampaign" class="primary">New Campaign</button>
 </div>

 <div id="campaignBox" class="panel form-panel hidden">
   <form id="campaignForm">
     <input name="name" required placeholder="Campaign name">
     <select name="status">
       <option>draft</option>
       <option>active</option>
       <option>paused</option>
     </select>
     <div class="toolbar">
       <button class="primary">Create Campaign</button>
       <button type="button" class="ghost cancel">Cancel</button>
     </div>
   </form>
 </div>

 <div class="panel">
  <table>
   <thead><tr><th>ID</th><th>Name</th><th>Status</th><th>Action</th></tr></thead>
   <tbody>
    ${
      S.campaigns.map(c=>`
      <tr>
       <td>#${c.id}</td>
       <td>${esc(c.name)}</td>
       <td><span class="status">${esc(c.status)}</span></td>
       <td><button class="danger deleteCampaign" data-id="${c.id}">Delete</button></td>
      </tr>`).join("")
      || `<tr><td colspan="4" class="empty">No campaigns</td></tr>`
    }
   </tbody>
  </table>
 </div>`;
}

const PLATFORM_INFO={
 facebook:"Connect with official Meta authorization",
 instagram:"Connect with official Instagram authorization",
 telegram:"Connect using your configured Telegram bot",
 x:"Connect with official X authorization",
 youtube:"Connect with official Google/YouTube authorization",
 tiktok:"Connect with official TikTok authorization",
 pinterest:"Connect with official Pinterest authorization",
 reddit:"Connect with official Reddit authorization"
}

function connectors(){
 const cards=Object.entries(PLATFORM_INFO).map(([p,info])=>`
 <div class="connector">
   <h3>${p[0].toUpperCase()+p.slice(1)}</h3>
   <p>${info}</p>
   <button class="ghost oauthInfo" data-platform="${p}">Connect</button>
 </div>`).join("");

 return `
 <div class="title-row">
   <h2>Social Accounts</h2>
   <button id="showWebsite" class="primary">Configure Website</button>
 </div>

 <div class="note" style="margin-bottom:16px">
   <b>Manual access-token fields are removed.</b>
   <div class="muted" style="margin-top:5px">
     Accounts are only marked connected after a real backend connector/OAuth flow succeeds.
   </div>
 </div>

 <div class="connector-grid">${cards}</div>

 <div id="websiteBox" class="panel form-panel hidden" style="margin-top:16px">
   <h3>Custom Website</h3>
   <p class="muted">Configure a webhook endpoint for website publishing.</p>
   <form id="websiteForm">
     <input name="account_name" required placeholder="Website name">
     <input name="webhook_url" type="url" required placeholder="https://example.com/api/webhook">
     <div class="toolbar">
       <button class="primary">Save Website Connector</button>
       <button type="button" class="ghost cancel">Cancel</button>
     </div>
   </form>
 </div>

 <div class="panel" style="margin-top:16px">
   <h3>Connected Accounts</h3>
   <table>
    <thead><tr><th>ID</th><th>Platform</th><th>Account</th><th>Status</th><th>Expires</th></tr></thead>
    <tbody>
    ${
      S.connectors.map(c=>`
       <tr>
        <td>#${c.id}</td>
        <td>${esc(c.platform)}</td>
        <td>${esc(c.account_name)}</td>
