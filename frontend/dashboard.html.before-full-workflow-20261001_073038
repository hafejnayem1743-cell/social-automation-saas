async function authenticate(form,register){
 const f=new FormData(form);
 const data=await api(register?"/api/auth/register":"/api/auth/login",{
   method:"POST",
   body:json({
     email:f.get("email"),
     password:f.get("password")
   })
 });

 if(!data.token) throw new Error("Server did not return a session token.");

 S.token=data.token;
 localStorage.setItem("nbsa_token",S.token);

 await loadAll();
 render();
 toast(register?"Workspace created":"Login successful");
}

async function readImageAsDataURL(file){
 return await new Promise((resolve,reject)=>{
   const reader=new FileReader();
   reader.onload=()=>resolve(String(reader.result||""));
   reader.onerror=()=>reject(new Error("Could not read the image"));
   reader.readAsDataURL(file);
 });
}

async function createPost(form){
 const f=new FormData(form);
 const content=String(f.get("content")||"").trim();
 const file=f.get("media_file");

 if(!content && !(file instanceof File && file.size)){
   throw new Error("Write text or attach a photo");
 }

 let media=null;

 if(file instanceof File && file.size){
   if(!file.type.startsWith("image/")){
     throw new Error("Please choose an image file");
   }

   if(file.size>5*1024*1024){
     throw new Error("Photo must be 5 MB or smaller");
   }

   media=await readImageAsDataURL(file);
 }

 await api("/api/posts",{
   method:"POST",
   body:json({
    content,
    media,
    status:f.get("status"),
    scheduled_at:String(f.get("scheduled_at")||"").trim()||null
   })
 });

 await loadAll();
 render();
 toast(media?"Post with photo created":"Text post created");
}

