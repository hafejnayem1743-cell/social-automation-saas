<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in · NBSA</title>
<link rel="stylesheet" href="./cyber.css">
<link rel="stylesheet" href="./auth.css">
</head>
<body class="authPage">
<div class="authShell">

  <section class="authVisual">
    <div class="logoMark">NB</div>
    <h2 class="brandTitle">NAYEM BOSS <span>SOCIAL AUTOMATION</span></h2>
    <p class="brandSub">Secure multi-platform publishing, target automation and server-side scheduling.</p>

    <div class="terminal">
      <div class="terminalTop">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="terminalTitle">nbsa-secure-shell</span>
      </div>
      <div class="terminalBody">
        <div class="tGreen">[OK] workspace runtime ready</div>
        <div class="tGreen">[OK] tenant isolation enabled</div>
        <div class="tGreen">[OK] scheduler worker monitored</div>
        <div class="tCyan">[AUTH] waiting for operator login...</div>
        <div class="tMuted">access: authorized users only</div>
      </div>
    </div>

    <div class="featureGrid">
      <div class="feature"><b>8 Platforms</b><span>Official connectors</span></div>
      <div class="feature"><b>Many Targets</b><span>Per-account target mapping</span></div>
      <div class="feature"><b>Scheduler</b><span>Queue + retry tracking</span></div>
      <div class="feature"><b>Security</b><span>Tenant-aware access</span></div>
    </div>
  </section>

  <section class="authForm">
    <div class="formInner">
      <div class="eyebrow">SECURE ACCESS</div>
      <h1>Welcome back</h1>
      <p class="desc">Sign in to your NBSA workspace.</p>

      <div id="message" class="message"></div>

      <form id="loginForm">
        <div class="field">
          <label for="email">Email</label>
          <input class="authInput" id="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="inputWrap">
            <input class="authInput" id="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
            <button class="showBtn" type="button" data-password-toggle="password">Show</button>
          </div>
        </div>

        <button class="primaryBtn" id="submitBtn" type="submit">Sign in</button>
      </form>

      <div class="links">
        <a href="./forgot.html">Forgot password?</a>
        <a href="./register.html">Create account</a>
      </div>

      <div class="apiState">
        <span class="apiDot" id="apiDot"></span>
        <span id="apiText">Checking API...</span>
      </div>
      <div class="smallNote">Your password and session are handled by the NBSA authentication API.</div>
    </div>
  </section>

</div>
<script src="./auth.js"></script>
</body>
</html>
