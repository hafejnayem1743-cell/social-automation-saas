from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json

HOST = "0.0.0.0"
PORT = 8000

class APIHandler(BaseHTTPRequestHandler):
    def send_json(self, data, status=200):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/health":
            return self.send_json({"status": "ok", "service": "api"})

        if self.path == "/":
            return self.send_json({
                "name": "NAYEM BOSS SOCIAL AUTOMATION",
                "version": "0.1.0",
                "status": "online"
            })

        if self.path == "/api/status":
            return self.send_json({
                "status": "ok",
                "service": "social-automation-api",
                "version": "0.1.0"
            })

        if self.path == "/api/tenants":
            return self.send_json({"items": []})

        if self.path == "/api/social/accounts":
            return self.send_json({"items": []})

        if self.path == "/api/posts":
            return self.send_json({"items": []})

        if self.path == "/api/campaigns":
            return self.send_json({"items": []})

        return self.send_json({"detail": "Not Found"}, 404)

    def log_message(self, format, *args):
        print("[API]", format % args)

if __name__ == "__main__":
    print(f"NAYEM BOSS SOCIAL AUTOMATION API")
    print(f"Running on http://127.0.0.1:{PORT}")
    ThreadingHTTPServer((HOST, PORT), APIHandler).serve_forever()
