{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nayem-boss-social-automation-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nbsa-production",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nbsa-media"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  }
}
